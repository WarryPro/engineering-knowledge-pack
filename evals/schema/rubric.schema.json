{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WarryPro/engineering-knowledge-pack/evals/schema/rubric.schema.json",
  "title": "EKP Evaluation Rubric",
  "description": "Evaluator-only rubric for a scenario; never sent to the model under evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "scenario_version",
    "version",
    "dimensions",
    "critical_failures"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "scenario_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Rubric artifact version"
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "technical-correctness",
          "architecture-boundaries",
          "tradeoff-reasoning",
          "maintainability-change-safety",
          "testing-verifiability",
          "security-operational-risk",
          "constraint-adherence"
        ]
      },
      "description": "Applicable core dimensions for this scenario (omit N/A dimensions)"
    },
    "criteria": {
      "type": "object",
      "description": "Optional per-dimension outcome criteria (engineering outcomes, not keywords)",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "critical_failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CF-[0-9]{2,}$",
            "description": "Stable local critical-failure identifier"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "strong_outcomes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptable_alternatives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "important_tradeoffs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
