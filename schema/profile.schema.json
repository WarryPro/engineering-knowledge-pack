{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/engineering-knowledge-pack/schema/profile.schema.json",
  "title": "EKP Profile",
  "description": "Composition manifest selecting knowledge for a specific context",
  "type": "object",
  "required": ["name", "description", "knowledge"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique profile identifier (kebab-case)"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "includes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "description": "Other profiles whose knowledge paths are composed into this profile (paths only; not inheritance)"
    },
    "knowledge": {
      "type": "array",
      "items": { "type": "string", "pattern": "^knowledge/.+\\.md$" },
      "minItems": 1,
      "description": "Paths to knowledge documents (rules are derived by adapters)"
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "severity": {
          "type": "array",
          "items": { "type": "string", "enum": ["required", "recommended", "advisory"] }
        },
        "applies_to": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "description": "Adapter generation settings for assemble.py",
      "properties": {
        "target": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["cursor", "copilot", "antigravity", "claude"]
          },
          "minItems": 1,
          "description": "Legacy adapter targets; prefer profile outputs (ADR-0009)"
        },
        "include": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "adapter_priority": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "minItems": 1,
              "description": "Filter concepts by adapter_priority from knowledge frontmatter"
            }
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["cursor", "copilot", "antigravity", "claude"]
      },
      "description": "Canonical adapter outputs requested for this profile (ADR-0009)"
    }
  }
}
